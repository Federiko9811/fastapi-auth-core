# Project Configuration
PROJECT_NAME="Your Project Name"
API_V1_STR="/api/v1"
APP_PORT=8000

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# JWT Configuration
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# WebAuthn / Passkeys Configuration
# RP_ID: Your domain (e.g., "example.com" for production, "localhost" for dev)
WEBAUTHN_RP_ID=localhost
# RP_NAME: Displayed to users during passkey prompts
WEBAUTHN_RP_NAME="Your Project Name"
# ORIGIN: Your frontend URL (must match exactly for security)
WEBAUTHN_ORIGIN=http://localhost:3000

# Redis Configuration (for challenge storage)
# Use "redis" as host when running with docker-compose
REDIS_URL=redis://localhost:6379

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false

# Rate Limiting (per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
